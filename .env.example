# Copy to .env and fill in ONE of the two options. Only `make annotate` calls the LLM;
# every other step runs from the shipped caches and needs no key. Values already set in your
# shell (for example an old GEMINI_API_KEY in ~/.zshrc) take precedence over this file.

# Option 1: Google AI Studio key
GEMINI_API_KEY=

# Option 2: Vertex AI (run `gcloud auth login` once; the project needs the Vertex AI API enabled)
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=global

# Optional
# LLM_BACKEND=api            # api | vertex, when both options are set
# LLM_MODEL=gemini-3.8-flash # the judge of the reference results
