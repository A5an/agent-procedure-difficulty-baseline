{
 "procedure_id": "p04_airline",
 "domain": "airline",
 "organization": "Meridian Air",
 "title": "Voluntary flight changes",
 "summary": "Move a confirmed booking to another flight on the same route when the passenger, fare and flight qualify, or send late changes for agent approval.",
 "entities": {
  "passenger": {
   "key": "passenger_id",
   "description": "Passengers holding bookings",
   "fields": {
    "passenger_id": "str",
    "full_name": "str",
    "email": "str",
    "birth_date": "date",
    "tier": "enum:standard|silver|gold"
   }
  },
  "flight": {
   "key": "flight_id",
   "description": "Scheduled flights",
   "fields": {
    "flight_id": "str",
    "origin": "str",
    "destination": "str",
    "depart_date": "date",
    "seats_available": "int"
   }
  },
  "booking": {
   "key": "booking_id",
   "description": "Ticketed bookings",
   "fields": {
    "booking_id": "str",
    "passenger_id": "ref:passenger",
    "flight_id": "ref:flight",
    "fare_class": "enum:basic|standard|flex",
    "status": "enum:confirmed|cancelled|flown",
    "contact_email": "str",
    "ticket_paid": "number",
    "changes": "int"
   }
  },
  "approval_request": {
   "key": "request_id",
   "description": "Requests for a duty agent to approve a change",
   "fields": {
    "request_id": "str",
    "booking_id": "ref:booking",
    "new_flight_id": "ref:flight",
    "reason": "enum:late_change|other",
    "created": "date"
   }
  }
 },
 "tools": [
  {
   "name": "get_passenger",
   "kind": "get",
   "entity": "passenger",
   "description": "Look up a passenger by passenger number."
  },
  {
   "name": "find_passenger_by_email",
   "kind": "search",
   "entity": "passenger",
   "by": [
    "email"
   ],
   "description": "Find passengers by the email address on their profile."
  },
  {
   "name": "get_flight",
   "kind": "get",
   "entity": "flight",
   "description": "Look up a flight by flight id."
  },
  {
   "name": "get_booking",
   "kind": "get",
   "entity": "booking",
   "description": "Look up a booking by booking reference."
  },
  {
   "name": "find_bookings_by_contact_email",
   "kind": "search",
   "entity": "booking",
   "by": [
    "contact_email"
   ],
   "description": "List bookings by the contact email on the booking."
  },
  {
   "name": "change_booking_flight",
   "kind": "update",
   "entity": "booking",
   "args": {
    "booking_id": {
     "type": "ref:booking",
     "description": "The booking to move."
    },
    "new_flight_id": {
     "type": "ref:flight",
     "description": "The flight to move the booking to."
    }
   },
   "set": {
    "flight_id": "args.new_flight_id",
    "changes": "rec.changes + 1"
   },
   "description": "Move a booking to a new flight and count one change."
  },
  {
   "name": "create_approval_request",
   "kind": "create",
   "entity": "approval_request",
   "args": {
    "booking_id": {
     "type": "ref:booking",
     "description": "The booking concerned."
    },
    "new_flight_id": {
     "type": "ref:flight",
     "description": "The flight the passenger wants."
    },
    "reason": {
     "type": "enum:late_change|other",
     "description": "Why approval is needed."
    }
   },
   "fields": {
    "booking_id": "args.booking_id",
    "new_flight_id": "args.new_flight_id",
    "reason": "args.reason",
    "created": "today"
   },
   "description": "Open a request for a duty agent to approve a flight change."
  }
 ],
 "request": {
  "booking_id": {
   "type": "ref:booking",
   "description": "the booking you want to move"
  },
  "new_flight_id": {
   "type": "ref:flight",
   "description": "the flight you want to be moved to"
  }
 },
 "claims": {
  "birth_date": {
   "type": "date",
   "description": "the passenger's date of birth"
  }
 },
 "bindings": [
  {
   "name": "booking",
   "entity": "booking",
   "key": "req.booking_id"
  },
  {
   "name": "pax",
   "entity": "passenger",
   "key": "booking.passenger_id"
  },
  {
   "name": "curf",
   "entity": "flight",
   "key": "booking.flight_id"
  },
  {
   "name": "newf",
   "entity": "flight",
   "key": "req.new_flight_id"
  }
 ],
 "outcomes": {
  "change": {
   "kind": "perform",
   "description": "Move the booking to the requested flight.",
   "calls": [
    {
     "tool": "change_booking_flight",
     "args": {
      "booking_id": "req.booking_id",
      "new_flight_id": "req.new_flight_id"
     }
    }
   ]
  },
  "approval": {
   "kind": "perform",
   "description": "Departure is close: open an approval request instead of changing.",
   "calls": [
    {
     "tool": "create_approval_request",
     "args": {
      "booking_id": "req.booking_id",
      "new_flight_id": "req.new_flight_id",
      "reason": "'late_change'"
     }
    }
   ]
  },
  "refuse": {
   "kind": "refuse",
   "description": "Do not change the booking; explain why.",
   "calls": []
  }
 },
 "rules": [
  {
   "id": "R1",
   "when": "claim.birth_date != pax.birth_date",
   "outcome": "refuse",
   "explain": "The caller must give the passenger's date of birth as on file before any change."
  },
  {
   "id": "R2",
   "when": "booking.status != 'confirmed' or booking.fare_class == 'basic' or newf.seats_available < 1 or newf.origin != curf.origin or newf.destination != curf.destination",
   "outcome": "refuse",
   "explain": "Only confirmed, non-basic bookings can move, to a flight on the same route that has a free seat."
  },
  {
   "id": "R3",
   "when": "days_between(today, curf.depart_date) < 3",
   "outcome": "approval",
   "explain": "If the current flight departs in less than 3 days, open an approval request instead of changing."
  }
 ],
 "default_outcome": "change",
 "policy_text": "## Identity\nBefore changing anything, find the booking and the passenger it belongs to. Ask for the passenger's date of birth; it must match the one on file. If it does not match or the caller cannot give it, make no change.\n\n## Finding the booking\nUse the booking reference if the caller has it. Otherwise search by the contact email on the booking. If several bookings come up, ask which one is meant. If the booking cannot be identified, or the caller cannot say which flight they want, do not guess; explain that you cannot proceed.\n\n## When a change is allowed\n- The booking must be confirmed, and its fare must not be basic. Basic fares cannot be changed.\n- The new flight must have the same origin and destination as the current flight and at least one seat available.\n- Always go by the system record, not by what the caller believes about their fare or flight.\n\n## Late changes\nIf all of the above is fine but the current flight departs in fewer than 3 days from today, do not change the booking yourself. Open an approval request with reason late_change for the new flight and tell the passenger a duty agent will follow up.\n\n## Otherwise\nIf everything is fine and departure is 3 or more days away, move the booking to the requested flight.\n\n## Never\nDo not waive fare restrictions, do not change a booking for someone who failed the identity check, and do not do anything the passenger did not ask for.",
